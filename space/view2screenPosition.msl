/*
contributors: Patricio Gonzalez Vivo
description: get screen coordinates from view position
use: <float2> view2screenPosition(<float3> viewPosition [, <float4x4> projection] )
options:
    - CAMERA_PROJECTION_MATRIX: float4x4 matrix with camera projection. Metal has no global uniforms, so the
      overload without a projection argument only exists when this is defined to something in scope
license:
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Prosperity License - https://prosperitylicense.com/versions/3.0.0
    - Copyright (c) 2021 Patricio Gonzalez Vivo under Patron License - https://lygia.xyz/license
*/

#ifndef FNC_VIEW2SCREENPOSITION
#define FNC_VIEW2SCREENPOSITION
float2 view2screenPosition(float3 viewPosition, float4x4 projection) {
    float4 clip = projection * float4(viewPosition, 1.0);
    return (clip.xy / clip.w + 1.0) * 0.5;
}

#ifdef CAMERA_PROJECTION_MATRIX
float2 view2screenPosition(float3 viewPosition) { return view2screenPosition(viewPosition, CAMERA_PROJECTION_MATRIX); }
#endif
#endif